# ──────────────────────────────────────────────
#  Prerequisite Gap Diagnoser — Environment Configuration
# ──────────────────────────────────────────────

# Anthropic Claude API Key (required for live LLM reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# LLM Configuration
# Options: claude-3-5-sonnet-20241022, claude-3-haiku-20240307, etc.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Offline / Mock LLM Mode for testing without API keys (true/false)
MOCK_LLM=true

# Database Path
SQLITE_DB_PATH=app/db/session_store.sqlite
